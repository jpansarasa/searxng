# SearXNG settings for this instance.
#
# This is a DELTA on the image's own settings.yml, not a copy of it. Every key
# absent here keeps the upstream default, so an upstream rename or a new setting
# is a non-event rather than something to reconcile by hand. It replaced a
# 2421-line vendored fork that had drifted two schema generations behind the
# running image: it still declared `redis:` where upstream had moved to
# `valkey:`, it carried a pre-2024 commented-out `enabled_plugins:` block that
# the code no longer reads at all, and five of its engine entries named modules
# the image had already deleted -- which logged a traceback on every start while
# the unit stayed green.
#
# Two placeholders are substituted by `install` via envsubst, from
# /tank/searxng/secrets.env. Nothing else in this file is templated.

use_default_settings:
  engines:
    # Whitelist, not a blocklist. An engine absent from this list does not exist
    # for this instance. That is the property the old vendored fork was really
    # protecting, and the reason to keep a list at all: upstream ships ~343
    # engines and adds more every release, and without this an update would
    # silently start fanning queries out to third parties nobody chose. Adding an
    # engine means adding its name here; there is nothing else to reconcile.
    #
    # Upstream marks 67 engines `inactive: true`, which stops them loading at
    # all. All 67 were probed from this host with three different queries rather
    # than trusted: 32 of them work fine, and six of those are re-enabled in the
    # engines: block below. Deliberately still ABSENT, because they were
    # measured dead here: google and google videos (zero results, no error --
    # silently blocked), yahoo news (HTTP protocol error), z-library (connection
    # refused), heexy and ebay (access denied), and searchzee (rate limited).
    # Re-probe before re-adding any of them; upstream's flag is a starting point,
    # not the answer.
    keep_only:
      - arch linux wiki
      - artic
      - arxiv
      - askubuntu
      - bandcamp
      - bing
      - bing images
      - bing news
      - bing videos
      - brave
      - brave.images
      - brave.news
      - brave.videos
      - bt4g
      - chefkoch
      - codeberg
      - currency
      - dailymotion
      - deviantart
      - dictzone
      - docker hub
      - duckduckgo
      - duckduckgo images
      - duckduckgo news
      - etymonline
      - flickr
      - genius
      - gentoo
      - github
      - gitlab
      - google images
      - google news
      - google scholar
      - hackernews
      - hoogle
      - lemmy comments
      - lemmy communities
      - lemmy posts
      - lemmy users
      - library of congress
      - lingva
      - mankier
      - mastodon hashtags
      - mastodon users
      - mdn
      - mixcloud
      - mymemory translated
      - openairedatasets
      - openairepublications
      - openstreetmap
      - openverse
      - pdbe
      - photon
      - pinterest
      - piratebay
      - pubmed
      - pypi
      - qwant
      - qwant images
      - qwant news
      - qwant videos
      - radio browser
      - repology
      - sepiasearch
      - solidtorrents
      - soundcloud
      - stackoverflow
      - superuser
      - swisscows
      - swisscows images
      - swisscows videos
      - tootfinder
      - unsplash
      - vimeo
      - wallhaven
      - wikicommons.audio
      - wikicommons.files
      - wikicommons.images
      - wikicommons.videos
      - wikidata
      - wikinews
      - wikipedia
      - wiktionary
      - wordnik
      - wttr.in
      - yahoo
      - youtube

general:
  # Deliberately generic. This file is public; the instance's own URL is the one
  # deployment-identifying value here and it comes from secrets.env.
  instance_name: "searxng"

search:
  # Server-side, so the browser never talks to the completer directly -- but the
  # instance's egress IP still ships a keystroke-granular stream of query
  # prefixes. duckduckgo rather than google: finer-grained than the full queries
  # the search engines already receive, so it should not go somewhere that can
  # join it to everything else.
  autocomplete: "duckduckgo"
  default_lang: "en"
  # json is a local addition (upstream ships html only) and is what makes this
  # instance usable as an API. It is also why the published port must stay
  # scoped -- see SEARXNG_BIND_ADDR in bind.env.
  formats:
    - html
    - json
  # Local tuning: back off hard and for a long time when an engine rate-limits
  # or captchas us, because this instance searches from a residential IP and
  # getting the address blocked is the failure that matters.
  suspended_times:
    SearxEngineAccessDenied: 0
    SearxEngineCaptcha: 86400
    SearxEngineTooManyRequests: 3600

server:
  base_url: ${SEARXNG_BASE_URL}
  secret_key: "${SEARXNG_SECRET_KEY}"
  http_protocol_version: "1.1"
  # Thumbnails are proxied through this instance instead of being fetched by the
  # browser straight from result-supplied hosts. Without it every result page
  # hands an arbitrary set of third parties the client's IP, User-Agent and TLS
  # fingerprint with no click required. Costs bandwidth that is irrelevant here.
  image_proxy: true
  # These two are upstream's defaults today, and they are pinned anyway: they are
  # the settings that decide whether this instance behaves as a public one, and
  # inheriting a flipped default silently is not a risk worth taking to save two
  # lines. See limiter.toml, which is inert while limiter is false.
  limiter: false
  public_instance: false

outgoing:
  # Wikidata's query service returns 403 to the bare `SearXNG/<version>` agent:
  # the Wikimedia and OSM user-agent policies require a contact handle, and
  # without one the wikidata engine fails to INITIALISE. That failure is
  # particularly nasty because initialisation happens once per worker -- the
  # engine does not merely error, it never registers, so /config kept
  # advertising it while every infobox query silently returned nothing, and it
  # stayed that way until the next restart. Verified from this host: bare agent
  # 403, agent with a contact URL 200.
  #
  # Only nine API-style engines send this agent (wikidata, wikipedia, photon,
  # marginalia, base, archlinux, sourcehut, keenable, unsplash) -- every
  # scraping engine uses a random browser agent instead -- so this identifies
  # the instance to the services whose policies ask for it and to nobody else.
  # It reuses the base URL rather than adding a value to maintain.
  useragent_suffix: "(+${SEARXNG_BASE_URL})"

# Per-engine overrides. Only genuine local choices survive here: entries that
# merely restated an upstream default, checker YAML anchors, and a hand-rolled
# json_engine definition of gitlab that upstream has since implemented natively
# were all dropped when this file stopped being a fork.
engines:
  - name: arxiv
    timeout: 4.0
  - name: bing
    disabled: false
  - name: codeberg
    disabled: false
  - name: currency
    categories: [general]
  - name: duckduckgo images
    categories: [images, web]
  - name: duckduckgo news
    categories: [news, web]
  - name: gitlab
    disabled: false
  - name: hackernews
    disabled: false
  - name: library of congress
    disabled: false
  - name: qwant
    disabled: false
  - name: qwant images
    disabled: false
  - name: qwant news
    disabled: false
  - name: qwant videos
    disabled: false
  - name: wikicommons.audio
    number_of_results: 10
  - name: wikicommons.files
    number_of_results: 10
  - name: wikicommons.images
    number_of_results: 10
    shortcut: wc
  - name: wikicommons.videos
    number_of_results: 10
  - name: wikipedia
    display_type: [infobox, list]
  - name: wordnik
    shortcut: def
  - name: yahoo
    disabled: false
  # Engines upstream ships `inactive: true` that were measured WORKING from this
  # host, so they are switched back on. Upstream deactivates a family as a unit
  # (all of google, all of swisscows), which is why enabling half of one is
  # normal rather than a mistake.
  #
  #   google images  ~100 results, while google web returns zero -- keep the half that works
  #   swisscows*     independent Swiss privacy engine; general/images/videos. Its
  #                  news endpoint returns an HTTP error every time and is left out.
  #   repology       ~200 results; the packages category otherwise has almost nothing
  #   wallhaven      wallpapers. It was briefly dropped on a bad test: it was probed
  #                  with a film title, and a wallpaper site reasonably returned
  #                  nothing. It returns 24 for "linux". Probe engines with a query
  #                  their own category would actually answer.
  - name: google images
    inactive: false
  - name: repology
    inactive: false
    disabled: false
  - name: swisscows
    inactive: false
    disabled: false
  - name: swisscows images
    inactive: false
    disabled: false
  - name: swisscows videos
    inactive: false
    disabled: false
  - name: wallhaven
    inactive: false
