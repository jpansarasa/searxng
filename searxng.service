[Unit]
Description=SearXNG container
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/searxng/compose.yml
ConditionPathIsDirectory=/tank/searxng

[Service]
Restart=always
RestartSec=30
Environment=DOCKER_UID=2100 DOCKER_GID=2100

# No image pull here: boot/start must be fast and network-order-independent.
# Updates are fetched out-of-band by searxng-update.timer and applied on the
# next (re)start. `up` still auto-pulls if the image is entirely missing.
ExecStart=-/usr/bin/docker compose --file /opt/searxng/compose.yml --project-name searxng up --remove-orphans

ExecStop=-/usr/bin/docker compose --file /opt/searxng/compose.yml --project-name searxng down --timeout 10

[Install]
WantedBy=multi-user.target
